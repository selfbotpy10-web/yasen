# BotFather token. Keep this secret; never commit real values to GitHub.
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN
BOT_USERNAME=YourBotUsernameWithoutAt
# Numeric Telegram user ID(s), comma-separated
ADMIN_IDS=123456789
# Public HTTPS domain of the Railway web service
WEBAPP_URL=https://your-web-service.up.railway.app
DATABASE_URL=sqlite:///nitro_self.db
SECRET_KEY=replace-with-a-long-random-secret
WEBAPP_AUTH_REQUIRED=true
SUPPORT_USERNAME=YourSupportUsernameWithoutAt
CHANNEL_USERNAME=YourChannelUsernameWithoutAt
